# ==============================================================================
# Medilo Lab - Frontend Angular Environment Configuration
# ==============================================================================
# Copia este archivo a .env para personalizar tu entorno local:
#   cp .env.example .env
# ==============================================================================

# Entorno de ejecución (development | production | staging)
APP_ENV=development

# URL base para las peticiones REST a la API de MedicalBooking.
# En desarrollo se recomienda '/api/v1' para usar el proxy inverso integrado.
API_BASE_URL=/api/v1

# Dirección del backend Flask al que redirige el proxy de desarrollo de Angular (proxy.conf.js)
API_PROXY_TARGET=http://localhost:5000

# URL pública del portal de pacientes (aplicación Flutter Web)
PATIENT_PORTAL_URL=http://localhost:4300

# Identificador UUID de la fuente de referencia clínica por defecto en desarrollo (seed)
DEFAULT_SOURCE_ID=f0000000-0000-4000-8000-000000000001

# Desfase horario de la sucursal respecto a UTC en horas (América/Guayaquil es UTC-5 sin DST)
BRANCH_UTC_OFFSET=-5
